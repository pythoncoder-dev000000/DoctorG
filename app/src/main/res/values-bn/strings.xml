    <string name="scam_guides_error">প্রতারণা সচেতনতা গাইড লোড করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।</string>
    <string name="scam_language_current">ভাষা: %1$s</string>
    <string name="scam_language_switch_to">%1$s-এ পরিবর্তন করুন</string>
    <string name="scam_evidence_checklist_title">অভিযোগের আগে প্রমাণ চেকলিস্ট</string>
    <string name="scam_evidence_item_1">প্রতারকের ফোন নম্বর, হোয়াটসঅ্যাপ প্রোফাইল বা SMS-এর স্ক্রিনশট</string>
    <string name="scam_evidence_item_2">UPI ট্রানজেকশন ID / UTR নম্বর এবং ব্যাংক স্টেটমেন্টের প্রমাণ</string>
    <string name="scam_evidence_item_3">প্রাপ্ত সন্দেহজনক লিংক URL বা ভুয়া APK-এর নাম</string>
    <string name="scam_evidence_item_4">তারিখ, সঠিক সময় এবং মোট ক্ষতির পরিমাণ (গোল্ডেন আওয়ারের মধ্যে জানান)</string>
