    <!-- Scam Awareness Guides & Language Switcher -->
    <string name="scam_helpline_title">தேசிய சைபர் கிரைம் உதவி எண் (இந்தியா)</string>
    <string name="scam_helpline_subtitle">UPI, KYC அல்லது டிஜிட்டல் கைது மோசடியில் பணம் கழிக்கப்பட்டால் உடனே 1930 எண்ணில் அழைக்கவும்.</string>
    <string name="scam_dial_1930">1930 அழைக்கவும்</string>
    <string name="scam_guides_title">மோசடி விழிப்புணர்வு வழிகாட்டிகள்</string>
    <string name="scam_red_flags_heading">எச்சரிக்கை அறிகுறிகள்:</string>
    <string name="scam_what_to_do_heading">என்ன செய்ய வேண்டும்:</string>
    <string name="scam_guides_empty">தற்போது மோசடி விழிப்புணர்வு வழிகாட்டிகள் எதுவும் இல்லை.</string>
    <string name="scam_guides_error">மோசடி விழிப்புணர்வு வழிகாட்டிகளை ஏற்ற முடியவில்லை. மீண்டும் முயற்சிக்கவும்.</string>
    <string name="scam_language_current">மொழி: %1$s</string>
    <string name="scam_language_switch_to">%1$s-க்கு மாறவும்</string>
    <string name="scam_evidence_checklist_title">புகார் செய்வதற்கு முன் ஆதார சரிபார்ப்புப் பட்டியல்</string>
    <string name="scam_evidence_item_1">மோசடியாளரின் தொலைபேசி எண், வாட்ஸ்அப் சுயவிவரம் அல்லது SMS ஸ்கிரீன்ஷாட்</string>
    <string name="scam_evidence_item_2">UPI பரிவர்த்தனை ID / UTR எண் மற்றும் வங்கி அறிக்கை ஆதாரம்</string>
    <string name="scam_evidence_item_3">வந்த சந்தேகமான இணைப்பு URL அல்லது போலி APK பெயர்</string>
    <string name="scam_evidence_item_4">தேதி, சரியான நேரம் மற்றும் இழந்த மொத்தத் தொகை (உடனடியாகப் புகாரளிக்கவும்)</string>
